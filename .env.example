# Server Configuration
SERVER_PORT=8080
ENV=development

# Database Configuration (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Redis Configuration (Required for Rate Limiting)
REDIS_URL=redis://localhost:6379

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=1

# Security & JWT Configuration
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRY_HOURS=1
BCRYPT_COST=12

# 2FA / OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=mock

# SMTP Email Configuration (Set OTP_PROVIDER=smtp to send real emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Store Auth <your-email@gmail.com>"
