# Server Configuration
SERVER_PORT=8080
ENV=development

# Database Configuration (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Redis Configuration (Required for Rate Limiting & Token Revocation)
# You can provide credentials embedded in REDIS_URL or use REDIS_PASSWORD separately.
# Format: redis://[:password@]host:port[/db] or redis://[user:password@]host:port[/db]
# Note: If password is in REDIS_URL, special characters (@, :, #, %) must be URL percent-encoded (e.g., p@ss -> p%40ss).
# If using REDIS_PASSWORD separately, no percent-encoding is needed.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Example with password embedded: REDIS_URL=redis://:yourpassword@localhost:6379/0
# Example with ACL user embedded: REDIS_URL=redis://default:yourpassword@localhost:6379/0

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=1

# Security & JWT Configuration
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
BCRYPT_COST=12

# 2FA / OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=kafka # 'kafka' (delegates to store_notification) or 'mock' (logs to console)

# Kafka Event Bus Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_AUTH_EVENTS=auth.events
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_CONSUMER_GROUP_AUTH=store-auth-user-events-group
ENABLE_USER_EVENTS_CONSUMER=true

