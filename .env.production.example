# ==========================================
# SERVER & ENVIRONMENT CONFIGURATION
# ==========================================
SERVER_PORT=8080
ENV=production

# ==========================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# Use transaction pooler (port 6543) or session mode (port 5432) with sslmode=require
# ==========================================
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PROD_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# ==========================================
# REDIS CONFIGURATION (Managed Redis with TLS)
# Use 'rediss://' for SSL/TLS encrypted Redis (e.g. Upstash, AWS ElastiCache, Redis Cloud)
# Format: rediss://[:password@]host:port[/db] or rediss://[user:password@]host:port[/db]
# You can embed the password directly in REDIS_URL or provide REDIS_PASSWORD separately.
# ==========================================
REDIS_URL="rediss://your-redis-instance.provider.com:6379/0"
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ==========================================
# RATE LIMITING CONFIGURATION
# Stricter production window and max requests
# ==========================================
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=1

# ==========================================
# SECURITY & JWT CONFIGURATION
# Paths to secrets mounted via Docker Secrets, K8s Secrets, or Vault
# ==========================================
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
BCRYPT_COST=12

# ==========================================
# 2FA / OTP & EVENT BUS CONFIGURATION
# ==========================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_PROVIDER=kafka

# Kafka Cluster Configuration
KAFKA_BROKERS="kafka-broker-1:9092,kafka-broker-2:9092"
KAFKA_TOPIC_AUTH_EVENTS=auth.events
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_CONSUMER_GROUP_AUTH=store-auth-user-events-group
ENABLE_USER_EVENTS_CONSUMER=true

