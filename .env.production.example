# ==========================================
# SERVER & ENVIRONMENT CONFIGURATION
# ==========================================
SERVER_PORT=8080
ENV=production

# ==========================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# Use transaction pooler (port 6543) or session mode (port 5432) with sslmode=require
# ==========================================
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PROD_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# ==========================================
# REDIS CONFIGURATION (Managed Redis with TLS)
# Use 'rediss://' for SSL/TLS encrypted Redis (e.g. Upstash, AWS ElastiCache, Redis Cloud)
# ==========================================
REDIS_URL="rediss://:YOUR_REDIS_PASSWORD@your-redis-instance.provider.com:6379/0"

# ==========================================
# RATE LIMITING CONFIGURATION
# Stricter production window and max requests
# ==========================================
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=1

# ==========================================
# SECURITY & JWT CONFIGURATION
# Paths to secrets mounted via Docker Secrets, K8s Secrets, or Vault
# ==========================================
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
JWT_EXPIRY_HOURS=1
BCRYPT_COST=12

# ==========================================
# 2FA / OTP CONFIGURATION
# Stricter max attempts in production
# ==========================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ==========================================
# EMAIL / SMS DELIVERY PROVIDER (Production OTP)
# ==========================================
# SMTP Email Provider (e.g., SendGrid, Resend, AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key
SMTP_FROM_EMAIL=noreply@yourstore.com

# SMS Provider (e.g., Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
