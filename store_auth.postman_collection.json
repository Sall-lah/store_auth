{
	"info": {
		"_postman_id": "store-auth-api-collection-v1",
		"name": "Store Auth Microservice API",
		"description": "Complete Postman Collection for testing the Store Auth Go microservice endpoints including Register, Verify OTP, Login, Get Me, Forgot Password, Reset Password, Logout, and JWKS.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "testEmail",
			"value": "john.doe@example.com",
			"type": "string"
		},
		{
			"key": "testPassword",
			"value": "SecretPass123!",
			"type": "string"
		},
		{
			"key": "testName",
			"value": "John Doe",
			"type": "string"
		},
		{
			"key": "otpCode",
			"value": "123456",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "JWKS",
			"item": [
				{
					"name": "Get JWKS Public Keys",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/jwks.json",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								".well-known",
								"jwks.json"
							]
						},
						"description": "Fetch public RSA JSON Web Key Set for verifying issued RS256 JWT tokens."
					},
					"response": []
				}
			]
		},
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"{{testName}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Register a new pending account. In dev environment (mock OTP provider), check server console log for generated 6-digit OTP."
					},
					"response": []
				},
				{
					"name": "2. Verify Registration OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{otpCode}}\",\n  \"type\": \"REGISTRATION\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"verify-otp"
							]
						},
						"description": "Verify 6-digit OTP code received during registration to activate user account."
					},
					"response": []
				},
				{
					"name": "3. Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticate user credentials. On success, server sets an HttpOnly access_token cookie automatically."
					},
					"response": []
				},
				{
					"name": "4. Get Current User Profile (Me)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Retrieve profile details of currently logged-in user using access_token session cookie."
					},
					"response": []
				},
				{
					"name": "5. Logout User",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Clear access_token session cookie."
					},
					"response": []
				}
			]
		},
		{
			"name": "Password Recovery",
			"item": [
				{
					"name": "1. Forgot Password Request",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/forgot-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"forgot-password"
							]
						},
						"description": "Request password reset OTP code sent to user email."
					},
					"response": []
				},
				{
					"name": "2. Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{otpCode}}\",\n  \"new_password\": \"NewSecretPass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/reset-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"reset-password"
							]
						},
						"description": "Reset password using OTP code."
					},
					"response": []
				}
			]
		}
	]
}
